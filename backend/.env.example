# Any OpenAI-compatible provider works. Leave LLM_BASE_URL empty for OpenAI.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Required, at least 32 characters. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ENV=dev
DATABASE_URL=sqlite:///./data/tangled.db
CORS_ORIGINS=http://localhost
REQUEST_MAX_BYTES=27000000
TRUSTED_PROXY=
JOIN_RATE_LIMIT_PER_MIN=100
CHAT_IP_RATE_LIMIT_PER_MIN=120
CHAT_STUDENT_RATE_LIMIT_PER_MIN=60
LOGIN_RATE_LIMIT_PER_MIN=10
EMBEDDING_CACHE_DIR=./data/embedding-cache
ENROLLED=24
# llm = rubric-based LLM judge, logreg = trained classifier (python -m ml.evaluate)
INTENT_BACKEND=llm
MIN_SIMILARITY=0.25
RAG_TOP_K=4
LLM_JSON_MODE=auto
LLM_MAX_CONCURRENCY=4
ANALYSIS_MAX_RETRIES=6
# failed analyses (e.g. LLM rate limits) are retried automatically: 30s, 60s, 120s, ...
ANALYSIS_RETRY_INTERVAL_S=30
ANALYSIS_RETRY_BASE_S=30
MAX_EVIDENCE_PHRASE_CHARS=120
MAX_QUIZ_IMPORT_MB=5
