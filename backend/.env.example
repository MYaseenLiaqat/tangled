# Any OpenAI-compatible provider works. Leave LLM_BASE_URL empty for OpenAI.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
TEACHER_TOKEN=change-me
DATABASE_URL=sqlite:///./data/tangled.db
ENROLLED=24
# llm = rubric-based LLM judge, logreg = trained classifier (python -m ml.evaluate)
INTENT_BACKEND=llm
